{
  "name": "multi-viewer",
  "version": "1.7.0",
  "description": "OmniView — Any File. One Viewer. Offline desktop file viewer",
  "type": "module",
  "main": "electron/main.cjs",
  "author": "4Raisan",
  "dependencies": {
    "docx-preview": "^0.4.1",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.2",
    "marked": "^18.1.0",
    "pdfjs-dist": "^6.4.299",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "electron": "^40.10.2",
    "electron-builder": "^26.15.3",
    "vite": "^8.3.4"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/copy-pdf-assets.mjs",
    "preview": "vite preview",
    "start": "electron .",
    "desktop": "npm run build && electron .",
    "test": "playwright test",
    "package": "npm run build && electron-builder --win nsis --x64"
  },
  "keywords": [
    "viewer",
    "excel",
    "word",
    "pdf",
    "markdown",
    "docx",
    "xlsx",
    "csv",
    "fast",
    "lightweight"
  ],
  "build": {
    "appId": "local.multiviewer.desktop",
    "productName": "OmniView",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "resources/**/*",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "OmniView-Portable-${version}-${arch}.${ext}",
      "signAndEditExecutable": true,
      "icon": "resources/app-icon.ico",
      "signExecutable": false
    },
    "portable": {
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "resources/installer.nsh",
      "artifactName": "OmniView-Setup-${version}-${arch}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "electronLanguages": [
      "en-US"
    ]
  }
}

{
  "name": "multi-viewer",
  "version": "1.9.0",
  "license": "MIT",
  "description": "OmniView — Any File. One Viewer. Offline desktop file viewer",
  "type": "module",
  "main": "app/electron/main.cjs",
  "scripts": {
    "dev": "vite --config tooling/vite.config.js",
    "build": "vite build --config tooling/vite.config.js && node tooling/scripts/copy-pdf-assets.mjs && node tooling/scripts/build-doc-reader.mjs",
    "preview": "vite preview --config tooling/vite.config.js",
    "start": "electron .",
    "desktop": "npm run build && electron .",
    "package": "npm run build && electron-builder --win nsis --x64 --publish never",
    "test": "node --test tooling/unit/*.test.cjs && playwright test --config tooling/playwright.config.cjs",
    "package:installer": "npm run package",
    "package:portable": "npm run build && electron-builder --win portable --x64 --publish never",
    "package:linux": "npm run build && electron-builder --linux AppImage deb --x64 --publish never",
    "package:mac": "npm run build && electron-builder --mac dmg --publish never"
  },
  "keywords": [
    "viewer",
    "excel",
    "word",
    "pdf",
    "markdown",
    "docx",
    "xlsx",
    "csv",
    "fast",
    "lightweight"
  ],
  "dependencies": {
    "docx-preview": "^0.4.1",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "jszip": "^3.10.2",
    "marked": "^18.1.0",
    "pdfjs-dist": "^6.4.299",
    "xlsx": "file:tooling/vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "electron": "^40.10.2",
    "electron-builder": "^26.15.3",
    "esbuild": "0.28.2",
    "vite": "^8.3.4",
    "word-extractor": "1.0.4"
  },
  "author": "4Raisan",
  "build": {
    "appId": "local.multiviewer.desktop",
    "productName": "OmniView",
    "directories": {
      "output": "release"
    },
    "files": [
      "app/dist/**/*",
      "app/electron/**/*",
      "app/resources/**/*",
      "package.json",
      "LICENSE",
      "!node_modules/**/*"
    ],
    "asar": true,
    "asarUnpack": ["app/electron/generated/**"],
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "OmniView-Portable-${version}-${arch}.${ext}",
      "signAndEditExecutable": true,
      "icon": "app/resources/app-icon.ico",
      "signExecutable": false
    },
    "portable": {
      "requestExecutionLevel": "user"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "include": "app/resources/installer.nsh",
      "artifactName": "OmniView-Setup-${version}-${arch}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "electronLanguages": [
      "en-US"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "icon": "app/resources/app-icon-mac.png",
      "artifactName": "OmniView-${version}-mac-${arch}.${ext}",
      "identity": "-",
      "fileAssociations": [
        {
          "ext": "pdf",
          "name": "PDF document",
          "role": "Viewer",
          "rank": "Alternate"
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "app/resources/app-icon.png",
      "artifactName": "OmniView-${version}-linux-${arch}.${ext}",
      "mimeTypes": [
        "application/pdf"
      ],
      "desktop": {
        "entry": {
          "Name": "OmniView",
          "Comment": "Any File. One Viewer.",
          "StartupWMClass": "OmniView"
        }
      },
      "executableName": "OmniView",
      "syncDesktopName": true,
      "maintainer": "4Raisan <207299898+4Raisan@users.noreply.github.com>"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/4Raisan/OmniView.git"
  },
  "homepage": "https://github.com/4Raisan/OmniView",
  "desktopName": "OmniView"
}
